# Copie este arquivo para ".env" e preencha os valores.

# Token do bot do Telegram (pegue com o @BotFather)
TELEGRAM_BOT_TOKEN=coloque_seu_token_aqui

# Seu nome (o PILAS usa pra te chamar)
OWNER_NAME=Chefe

# ===== Provedor de IA =====
# "gemini" tem tier GRÁTIS (recomendado) | "anthropic" é pago
PROVIDER=gemini

# --- Se PROVIDER=gemini ---
# Pegue a chave grátis em https://aistudio.google.com/apikey
GEMINI_API_KEY=coloque_sua_chave_gemini_aqui
# (Opcional) Mais chaves p/ rodízio — multiplica a quota grátis. Separadas por vírgula:
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Se PROVIDER=anthropic (pago) ---
# https://console.anthropic.com
ANTHROPIC_API_KEY=
MODEL=claude-opus-4-8
EFFORT=medium

# ===== Opcional =====
# Trava o bot pra responder só pra você. Pegue seu ID no @userinfobot.
# Vazio = libera pra qualquer um.
ALLOWED_USER_IDS=

# Resolve mensagens comuns localmente, sem gastar IA (recomendado). true/false
FAST_PATH=true

DB_PATH=pilas.db
CHARTS_DIR=charts
